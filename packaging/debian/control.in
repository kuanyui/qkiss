Source: @PROJECT_NAME@
Section: games
Priority: optional
Maintainer: kuanyui <azazabc123@gmail.com>
Build-Depends:
 debhelper-compat (= 13),
 dh-apparmor,
 apparmor,
 cmake,
 build-essential,
 g++,
 pkg-config,
 qt6-base-dev,
 qt6-tools-dev,
 qt6-multimedia-dev,
 libavcodec59 | libavcodec60 | libavcodec61 | libavcodec62,
 libavformat59 | libavformat60 | libavformat61 | libavformat62,
 libarchive-dev,
 desktop-file-utils,
 python3-jsonschema,
 python3-yaml,
 inkscape
Standards-Version: 4.6.2
Rules-Requires-Root: no
Homepage: @PROJECT_HOMEPAGE_URL@

Package: @PROJECT_NAME@
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Recommends: lha, unar
Suggests: @PROJECT_NAME@-apparmor
Description: @PROJ_DESCRIPTION_DEBIAN@

Package: @PROJECT_NAME@-apparmor
Architecture: all
Depends: @PROJECT_NAME@ (>= ${source:Version}), apparmor (>= 4.1~), ${misc:Depends}
Description: @PROJ_APPARMOR_DESCRIPTION_DEBIAN@
