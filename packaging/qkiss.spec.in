# RPM spec file for package @PROJECT_NAME@
#
# Copyright (c) 2025 - 2026 kuanyui <azazabc123@gmail.com>
#
# License: GPLv3

Name:            @PROJECT_NAME@
Version:         @PROJECT_VERSION@
Release:         0
Summary:         @PROJ_SUMMARY@
License:         GPL-3.0-or-later

Group:           Amusements/Toys/Graphics
URL:             @PROJECT_HOMEPAGE_URL@

# - The URL is real and kept as documentation. Though rpmbuild uses the file name part only, and OBS does also NOT download a plain `Source:` URL (I haven't tried `#!RemoteAsset`?).
Source0:         @PROJECT_HOMEPAGE_URL@/releases/download/v%{version}/@TARBALL_BASENAME@.tar.gz

BuildRequires:  cmake
BuildRequires:  gcc-c++
BuildRequires:  make

# Qt6 itself heavily relies on `cmake()`, so it will be more reliable than `pkgconfig()` among various distros (openSUSE, Fedora).
BuildRequires:  cmake(Qt6Core)
BuildRequires:  cmake(Qt6Gui)
BuildRequires:  cmake(Qt6Widgets)
BuildRequires:  cmake(Qt6Multimedia)
BuildRequires:  cmake(Qt6Concurrent)
BuildRequires:  cmake(Qt6OpenGL)

# Actually this is a little dirty, but QtLinguist binary and `*.cmake` are provided by different package name among different distros, I hate another condition macro for this:
# openSUSE:   qt6-tools,     qt6-tools-linguist
# Fedora:     qt6-qttools,   qt6-linguist
BuildRequires:  cmake(Qt6LinguistTools)

BuildRequires:  libarchive-devel

# https://en.opensuse.org/openSUSE:Packaging_Conventions_RPM_Macros#%desktop_database_post_/_%desktop_database_postun_(deprecated)
BuildRequires:  desktop-file-utils
Requires(pre):  desktop-file-utils
Requires(post): desktop-file-utils

BuildRequires:  inkscape

BuildRequires:  python-rpm-macros
# If `_repository` is defined (only on osc/OBS) and evaluates to true (like being set to 1). `0` prefix is a fallback when the expanded macro is an empty string.
%if 0%{?suse_version} && 0%{?_repository:1}
BuildRequires:  %{primary_python}-jsonschema
BuildRequires:  %{primary_python}-PyYAML
%else
BuildRequires:  python3dist(jsonschema)
BuildRequires:  python3dist(pyyaml)
%endif

Recommends:     lha
Recommends:     unar

# ----------------------------
# AppArmor (optional package)
# ----------------------------
# The optional `qkiss-apparmor` package, only for openSUSE: Fedora uses SELinux instead.
# `apparmor-abstractions` has `/etc/apparmor.d/abi/`, which tells CMake whether to use abi 5.0 (see `QKISS_INSTALL_APPARMOR` in `CMakeLists.txt`).
%if 0%{?suse_version}
BuildRequires:  apparmor-abstractions
BuildRequires:  apparmor-rpm-macros
Suggests:       %{name}-apparmor

# declare a package with suffix "apparmor"
%package apparmor
Summary:        @PROJ_APPARMOR_SUMMARY@
BuildArch:      noarch
Requires:       %{name} = %{version}-%{release}
Requires:       apparmor-abstractions
Requires:       apparmor-parser >= 4.1

%description apparmor
@PROJ_APPARMOR_DESCRIPTION@
%endif


# ---------------------------- (macro `description` is placed here because it doesn't stop reading lines until next percent symbol macro...)
%description
@PROJ_DESCRIPTION@

# ----------------------------
%prep
# -n specifies the child folder name after extract.
%setup -n @TARBALL_BASENAME@

# ----------------------------
%build
%if 0%{?suse_version}
%cmake -DQKISS_INSTALL_APPARMOR=ON
%else
%cmake
%endif
%cmake_build

# ----------------------------
%install
%cmake_install

# ----------------------------
%post
# update‐desktop‐database - Build cache database of MIME types handled by desktop files
# update‐mime‐database - a program to build the Shared MIME‐Info database cache
update-desktop-database
# update-mime-database %{_datadir}/mime

# ----------------------------
%postun
update-desktop-database
# update-mime-database %{_datadir}/mime

# ----------------------------
%if 0%{?suse_version}
%post apparmor
%apparmor_reload %{_sysconfdir}/apparmor.d/qkiss

# ----------------------------
%preun apparmor
# Removing (not upgrading) the package unloads the profile at once.
if [ $1 -eq 0 ]; then
    /sbin/apparmor_parser -R %{_sysconfdir}/apparmor.d/qkiss > /dev/null 2>&1 || :
fi
%endif

# ----------------------------
%files

%{_datadir}/icons/hicolor/*/apps/%{name}.*
%{_datadir}/applications/%{name}.desktop
%{_bindir}/%{name}

# ----------------------------
%if 0%{?suse_version}
%files apparmor
%config(noreplace) %{_sysconfdir}/apparmor.d/qkiss
%config(noreplace) %{_sysconfdir}/apparmor.d/abstractions/qkiss-deny-high-value
%endif

# ----------------------------
%changelog

@CHANGELOG_FOR_RPM_SPEC@