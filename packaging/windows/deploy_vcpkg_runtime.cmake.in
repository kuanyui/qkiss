# =============================================
# !!!!! BE CAREFUL !!!!!
# - This file only handles "install-time".
# - This file should be used via `install(SCRIPT ...)` in CMakeLists.txt
# - These variables must be configured in CMakeLists.txt:
#   - DUMPBIN_EXECUTABLE_CONFIGURED
#   - VCPKG_BIN_CONFIGURED    (`bumpbin.exe` is provided by MSVC, so must be determined during configure time,)
# =============================================
#
set(DUMPBIN_EXECUTABLE_CONFIGURED "@DUMPBIN_EXECUTABLE_CONFIGURED@")
set(VCPKG_BIN_CONFIGURED "@VCPKG_BIN_CONFIGURED@")

# `CMAKE_INSTALL_*` should not be determined during configure time, so the main app's *.exe should be decide here.
set(MAIN_APP_EXECUTABLE "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/${CMAKE_PROJECT_NAME}.exe")

if(NOT EXISTS "${MAIN_APP_EXECUTABLE}")
    message(STATUS "Skip vcpkg DLL deploy: ${MAIN_APP_EXECUTABLE} not installed in this install(COMPONENT \"${CMAKE_INSTALL_COMPONENT_NAME}\")")
    return()
endif()

execute_process(
    COMMAND "${DUMPBIN_EXECUTABLE_CONFIGURED}" /dependents "${MAIN_APP_EXECUTABLE}"
    OUTPUT_VARIABLE _raw_dumpbin_out
)

string(REPLACE "\r\n" "\n" _raw_dumpbin_out "${_raw_dumpbin_out}")
string(REPLACE "\n" ";" dumpbin_list "${_raw_dumpbin_out}")

foreach(line   IN LISTS    dumpbin_list)
    if (line MATCHES "([A-Za-z0-9_.-]+[.]dll)")
        set(dll_filename "${CMAKE_MATCH_1}")
        set(dll_src_file "${VCPKG_BIN_CONFIGURED}/${dll_filename}")
        set(dll_dst_dir  "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}")
        set(dll_dst_file "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/${dll_filename}")
        if (EXISTS "${dll_src_file}" AND NOT EXISTS "${dll_dst_file}")
            message(STATUS "Deploy vcpkg DLL: ${dll_filename}")
            file(COPY "${dll_src_file}" DESTINATION "${dll_dst_dir}")
        endif()
    endif()
endforeach()
