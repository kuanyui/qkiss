# =============================================
# !!!!! BE CAREFUL !!!!!
# - This file only handles "install-time".
# - This file should be used via `install(SCRIPT ...)` in CMakeLists.txt
# - This file relys on `lucasg.Dependencies`, to replace useless `dumpbin`
# - These variables must be configured in CMakeLists.txt:
#
#   - Explicit:
#     - DEPENDENCIES_EXECUTABLE_CONFIGURED  (via `find_program(DEPENDENCIES_EXECUTABLE_CONFIGURED Dependencies)`. `dumpbin.exe` is provided by MSVC, so must be determined during configure time.)
#
#   - Implicit:
#     - VCPKG_INSTALLED_DIR (via `-DCMAKE_TOOLCHAIN_FILE="$env:VCPKG_INSTALLATION_ROOT/scripts/buildsystems/vcpkg.cmake"` during configure time)
#     - VCPKG_TARGET_TRIPLET (via `-DCMAKE_TOOLCHAIN_FILE="$env:VCPKG_INSTALLATION_ROOT/scripts/buildsystems/vcpkg.cmake"` during configure time)
#     - CMAKE_INSTALL_BINDIR (via `include(GNUInstallDirs)`, rel path.)
#     - CMAKE_PROJECT_NAME (via `project(<name>`)
# =============================================

# `set()` here for improving syntax highlights of cmake.
set(DEPENDENCIES_EXECUTABLE_CONFIGURED "@DEPENDENCIES_EXECUTABLE_CONFIGURED@")

set(VCPKG_INSTALLED_DIR "@VCPKG_INSTALLED_DIR@")
set(VCPKG_TARGET_TRIPLET "@VCPKG_TARGET_TRIPLET@")
set(CMAKE_INSTALL_BINDIR "@CMAKE_INSTALL_BINDIR@")
set(CMAKE_PROJECT_NAME "@CMAKE_PROJECT_NAME@")


set(MAIN_APP_EXECUTABLE "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/${CMAKE_PROJECT_NAME}.exe")

# Determine to use which (Release/Debug) DLLs folder.
set(_vcpkg_bin_release "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/bin")
set(_vcpkg_bin_debug   "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/debug/bin")
set(VCPKG_BIN_DIR "${_vcpkg_bin_release}")
if(DEFINED CMAKE_INSTALL_CONFIG_NAME AND CMAKE_INSTALL_CONFIG_NAME STREQUAL "Debug")
    set(VCPKG_BIN_DIR "${_vcpkg_bin_debug}")
endif()

# debug
message("[deploy_vcpkg_runtime(Dependencies.exe)] VCPKG_BIN_DIR = ${VCPKG_BIN_DIR}")
message("[deploy_vcpkg_runtime(Dependencies.exe)] DEPENDENCIES_EXECUTABLE_CONFIGURED = ${DEPENDENCIES_EXECUTABLE_CONFIGURED}")
message("[deploy_vcpkg_runtime(Dependencies.exe)] MAIN_APP_EXECUTABLE = ${MAIN_APP_EXECUTABLE}")

if(NOT EXISTS "${MAIN_APP_EXECUTABLE}")
    message(WARNING "Skip vcpkg DLL deploy: ${MAIN_APP_EXECUTABLE} not installed in this install(COMPONENT \"${CMAKE_INSTALL_COMPONENT_NAME}\")")
    return()
endif()

set(ENV{PATH} "${VCPKG_BIN_DIR};$ENV{PATH}")  # Make Dependencies.exe able to search in vcpkg bin dir first.
execute_process(
    COMMAND "${DEPENDENCIES_EXECUTABLE_CONFIGURED}" -chain -depth 3 "${MAIN_APP_EXECUTABLE}"
    OUTPUT_VARIABLE _raw_dependencies_out
)

string(REPLACE "\r\n" "\n" _raw_dependencies_out "${_raw_dependencies_out}")
string(REPLACE "\n" ";" dependencies_lines "${_raw_dependencies_out}")



string(REPLACE "\\" "/" vcpkg_bin_dir_normalized "${VCPKG_BIN_DIR}")
message("[deploy_vcpkg_runtime(Dependencies.exe)] vcpkg_bin_dir_normalized = ${vcpkg_bin_dir_normalized}")

set(deploy_dst_dir "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}")
set(_copied_dll_names "")



foreach(line    IN LISTS    dependencies_lines)
    if(NOT line MATCHES "([A-Za-z]:[/\\\\][^:]*[.]dll)")
        continue()
    endif()
    set(dll_src_file_path "${CMAKE_MATCH_1}")
    string(REPLACE "\\" "/" dll_src_file_path "${dll_src_file_path}")

    if(dll_src_file_path MATCHES "^C:/Windows/")
        continue()
    endif()

    message("[deploy_vcpkg_runtime(Dependencies.exe)][DEBUG] src = ${dll_src_file_path}")
    # If DLL is not inside vcpkg bin/ directory (not installed via vcpkg), skip.
    if(NOT dll_src_file_path MATCHES "^${vcpkg_bin_dir_normalized}")
        continue()
    endif()

    get_filename_component(dll_filename "${dll_src_file_path}" NAME)
    set(dll_dst_file_path "${deploy_dst_dir}/${dll_filename}")
    message("[deploy_vcpkg_runtime(Dependencies.exe)][DEBUG][MATCHED] src = ${dll_src_file_path}")
    message("[deploy_vcpkg_runtime(Dependencies.exe)][DEBUG][MATCHED] dst = ${dll_dst_file_path}")

    # If this DLL is already copied. skip
    list(FIND _copied_dll_names "${dll_filename}" _seen)
    if(NOT _seen EQUAL -1)
        continue()
    endif()
    message("[deploy_vcpkg_runtime(Dependencies.exe)][DEBUG][MATCHED][need copy] = ${dll_filename}")

    if(NOT EXISTS "${dll_dst_file_path}")
        message("[deploy_vcpkg_runtime(Dependencies.exe)] Deploy vcpkg DLL: ${dll_filename}")
        file(COPY "${dll_src_file_path}" DESTINATION "${deploy_dst_dir}")
    endif()

    list(APPEND _copied_dll_names "${dll_filename}")
endforeach()

