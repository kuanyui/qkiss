# =============================================
# !!!!! BE CAREFUL !!!!!
# - This file only handles "install-time".
# - This file should be used via `install(SCRIPT ...)` in CMakeLists.txt
# - `windeployqt` handles Qt libraries only, other packages installed via vcpkg are ignored.
#   - Explicit:
#     - WINDEPLOYQT_EXECUTABLE_CONFIGURED
#
#   - Implicit:
#     - CMAKE_INSTALL_BINDIR (via `include(GNUInstallDirs)`, rel path.)
#     - CMAKE_PROJECT_NAME (via `project(<name>`)
# =============================================


# `set()` here for improving syntax highlights of cmake.
set(WINDEPLOYQT_EXECUTABLE_CONFIGURED "@WINDEPLOYQT_EXECUTABLE_CONFIGURED@")

set(CMAKE_INSTALL_BINDIR "@CMAKE_INSTALL_BINDIR@")
set(CMAKE_PROJECT_NAME "@CMAKE_PROJECT_NAME@")

# `CMAKE_INSTALL_*` should not be determined during configure time, so the main app's *.exe should be decide here.
set(MAIN_APP_EXECUTABLE "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/${CMAKE_PROJECT_NAME}.exe")

message("[deploy_qt_runtime] CMAKE_INSTALL_PREFIX = ${CMAKE_INSTALL_PREFIX}")
message("[deploy_qt_runtime] CMAKE_INSTALL_BINDIR = ${CMAKE_INSTALL_BINDIR}")
message("[deploy_qt_runtime] CMAKE_INSTALL_COMPONENT = ${CMAKE_INSTALL_COMPONENT}")
message("[deploy_qt_runtime] WINDEPLOYQT_EXECUTABLE_CONFIGURED = ${WINDEPLOYQT_EXECUTABLE_CONFIGURED}")
message("[deploy_qt_runtime] MAIN_APP_EXECUTABLE = ${MAIN_APP_EXECUTABLE}")

if(NOT EXISTS "${MAIN_APP_EXECUTABLE}")
    message(WARNING "[deploy_qt_runtime] Skip windeployqt, because \"${MAIN_APP_EXECUTABLE}\" not installed in this install(COMPONENT \"${CMAKE_INSTALL_COMPONENT_NAME}\")")
    return()
endif()

# `windeployqt` options:
#   --no-translations          Don't include Qt built-in lots of *.qm files.
#   --compiler-runtime         Copy the C++ runtime DLLs according to the used compiler.
#   --no-opengl-sw             Don't include OpenGL driver used in software rendering.
#   --no-system-d3d-compiler   Don't include DirectX compiler

execute_process(
    COMMAND "${WINDEPLOYQT_EXECUTABLE_CONFIGURED}"
    --no-translations
    --compiler-runtime
    --no-opengl-sw
    --no-system-d3d-compiler
    "${MAIN_APP_EXECUTABLE}"
    RESULT_VARIABLE WINDEPLOYQT_RESULT
    OUTPUT_VARIABLE WINDEPLOYQT_OUTPUT
    ERROR_VARIABLE WINDEPLOYQT_ERROR
)

if(NOT WINDEPLOYQT_RESULT EQUAL 0)
    message(FATAL_ERROR "[deploy_qt_runtime] windeployqt.exe failed with error:
    Result: ${WINDEPLOYQT_RESULT}
    Log: ${WINDEPLOYQT_OUTPUT}
    Error: ${WINDEPLOYQT_ERROR}")
endif()
