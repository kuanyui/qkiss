{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal Changelog Schema",
  "description": "Schema for a unified changelog format that can be converted to RPM and Debian changelogs.",
  "type": "object",
  "properties": {
    "releases": {
      "type": "array",
      "description": "List of changelog entries, each describing one release.",
      "items": {
        "type": "object",
        "properties": {
          "srcpkgname": {
            "type": "string",
            "description": "Name of this package."
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+){2}$",
            "description": "Package version string, e.g. `1.2.3`."
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Release date and time in ISO 8601 format, e.g. `2025-12-10T12:00:00+08:00`."
          },
          "maintainer": {
            "type": "string",
            "description": "Name and email of the maintainer, e.g. `Tanaka <tanaka@buncololi.com>`.",
            "pattern": "^[^<>]+ <[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}>$"
          },
          "rpm": {
            "type": "object",
            "description": "RPM-specific metadata for this release.",
            "properties": {
              "release": {
                "type": "string",
                "description": "RPM release number, usually `1`, optionally with distro suffix like `.fc40`. (Unused currently)"
              }
            },
            "required": []
          },
          "deb": {
            "type": "object",
            "description": "Debian-specific metadata for this release.",
            "properties": {
              "revision": {
                "type": "string",
                "description": "In `debian/changelog`, the version must be `UpstreamVersion-DebianRevision`. Default is `1`. (Unused currently, use `1` implicitly)"
              },
              "distribution": {
                "type": "string",
                "description": "Debian distribution target, e.g. `unstable`, `bookworm`. (Unused currently, always use `unstable`)"
              },
              "urgency": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "Debian urgency level: low, medium, or high."
              }
            },
            "required": [ "urgency"]
          },
          "body": {
            "type": "object",
            "description": "Structured changelog categories. Each key is optional, but if present must be an array of change descriptions.",
            "properties": {
              "added": {
                "type": "array",
                "description": "New features or functionality introduced.",
                "items": { "type": "string" },
                "minItems": 1
              },
              "fixed": {
                "type": "array",
                "description": "Bug fixes or corrections applied.",
                "items": { "type": "string" },
                "minItems": 1
              },
              "removed": {
                "type": "array",
                "description": "Features or functionality removed.",
                "items": { "type": "string" },
                "minItems": 1
              },
              "style": {
                "type": "array",
                "description": "Stylistic changes (UI, art, etc.).",
                "items": { "type": "string" },
                "minItems": 1
              },
              "performance": {
                "type": "array",
                "description": "Performance improvements.",
                "items": { "type": "string" },
                "minItems": 1
              },
              "build": {
                "type": "array",
                "description": "Build system or tooling changes.",
                "items": { "type": "string" },
                "minItems": 1
              },
              "security": {
                "type": "array",
                "description": "Security fixes or improvements.",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["srcpkgname", "version", "date", "maintainer", "deb", "body"]
      }
    }
  },
  "required": ["releases"]
}
