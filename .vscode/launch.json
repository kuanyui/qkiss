{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch gdb (CMake preset)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${fileDirname}",
            "environment": [
                {
                    // Don't let `debuginfod` to download debug symbol. Debug info will be force downloaded when this env var has value.
                    // (in openSUSE, this value is assigned to `https://debuginfod.opensuse.org/`)
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "gdb の再フォーマットを有効にする",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "逆アセンブリ フレーバーを Intel に設定",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod (don't download debug symbols, because I don't need to trace the internal implementations of Qt / C++ libraries)",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
            ]
        }
    ]
}
