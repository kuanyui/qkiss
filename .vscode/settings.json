{
    "files.associations": {
        "*.tcc": "cpp",
        "*.ts": "xml",
        "optional": "cpp",
        "source_location": "cpp",
        "VERSION": "plaintext",
        "*.cmake.in": "cmake",
        "PKGBUILD.in": "shellscript",
        "*.desktop.in": "ini",
        "*.desktop": "ini",
        "*.spec.in": "RPMSpec",
        "*.nsh.in": "nsis",
    },
    "python.analysis.languageServerMode": "default",
    "python.analysis.typeCheckingMode": "strict",
    // Ask C/C++ Extension to auto detect the path of `compile_commands.json` generated by CMake
    // (`compile_commands.json` can make able to resolve the included files of `#include`)
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    // Highlight @VAR@ in all files if `fabiospampinato.vscode-highlight` is installed.
    "highlight.regexes": {
      "(@)([_A-Za-z][_A-Za-z0-9]{0,40}?)(@)": [
        { "color": "#ff99cc" },
        { "color": "#ff66aa" },
        { "color": "#ff99cc" },
      ],
    },
}